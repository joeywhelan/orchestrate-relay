# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Local .terraform directories
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# such as passwords, private keys, and other secrets. These should not be
# part of version control as they are data points which are potentially
# sensitive and subject to change depending on the environment.
*.tfvars
*.tfvars.json

# Terraform CLI configuration file
.terraformrc

# Terraform override files
# These files are used to override default configurations and may contain
# environment-specific or sensitive information.
override.tf
override.tf.json
*override.tf
*override.tf.json

# Terraform plan files
# These files store the execution plan and might contain sensitive data.
*.tfplan

# Terraform lock file
# While some advocate for committing this, it's often ignored to avoid
# unnecessary changes from different environments or provider versions
# locking, especially in multi-developer setups or CI/CD pipelines.
.terraform.lock.hcl

# Virtual environment and environment variable files
.venv
.env
.env.*
!.env.example

# Test evidence output (SLA runs — contain instance-specific data)
results/

# Externally supplied acceptance criteria — delivered out-of-band, never committed
requirements/acceptance_criteria.md

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Python tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
htmlcov/

# Claude Code local preferences
.claude/settings.local.json
.claude/skills/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Generic logs
*.log